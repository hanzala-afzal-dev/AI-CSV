{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/guard-gh.mjs",
            "shell": "bash",
            "timeout": 10,
            "statusMessage": "Checking GitHub attribution"
          }
        ]
      }
    ]
  }
}
